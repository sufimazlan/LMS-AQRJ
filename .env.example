# Copy to .env for local development. Never commit .env.
#
# Both values are PUBLIC: they are compiled into the browser bundle.
# Row-level security in the database is what protects the data, not these keys.
# Leave them empty to run the app without a backend; the sign-in page will say so.

# Supabase project URL, for example https://abcdefghijkl.supabase.co
PUBLIC_SUPABASE_URL=

# Supabase publishable key (older projects call it the "anon" key)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
