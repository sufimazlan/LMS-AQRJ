{
	"name": "lms-aqrj",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "npm run types || echo ''",
		"types": "wrangler types --include-main-module=false && svelte-kit sync",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --emit-ts-declarations --silent",
		"check": "npm run types && npm run i18n && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"check:bundle": "node scripts/check-bundle.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/plugin-m-function-matcher": "^2.4.3",
		"@inlang/plugin-message-format": "^4.6.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.73.0",
		"@supabase/auth-js": "^2.119.0",
		"@supabase/postgrest-js": "^2.119.0"
	},
	"description": "AQRJ LMS: learning app for Akademi Quran Raudhatul Jannah",
	"engines": {
		"node": ">=22.17"
	}
}
